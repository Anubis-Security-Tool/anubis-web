{
  "name": "anubis-web",
  "version": "5.7.5",
  "description": "Anubis-Security-Tool: unified terminal, SSH, SFTP, RDP, VNC, Spice, MCP and batch workflows.",
  "main": "src/app/app.js",
  "type": "module",
  "bin": {
    "anubis-web": "npm/anubis-web.js"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node ./src/app/app.js",
    "prod": "cross-env NODE_ENV=production node ./src/app/app.js",
    "managed": "node scripts/start-managed.js",
    "setup-managed": "node scripts/configure-managed.js",
    "setup-source": "node scripts/install-source.js",
    "prepack": "node build/bin/verify-package.js",
    "build": "npm run compile",
    "start": "cross-env NODE_ENV=development node ./build/vite/dev-server.js",
    "clean": "node build/bin/clean.js",
    "compile": "node build/bin/build.js",
    "vite-build": "cross-env NODE_ENV=production vite build --config ./build/vite/conf.js",
    "install": "node build/bin/install.js",
    "lint": "standard --verbose",
    "fix": "./node_modules/.bin/standard --fix",
    "lock": "npm install --package-lock-only --ignore-scripts --legacy-peer-deps --registry=https://npm.anubis.locker/ && node build/bin/registry-lock.js",
    "r": "./build/bin/release",
    "test": "npm run test1 && npm run test2",
    "test1": "./node_modules/.bin/playwright test test/e2e/00*.js --config test/playwright.conf.js",
    "test2": "./node_modules/.bin/playwright test test/e2e/01*.js --config test/playwright.conf.js",
    "test3": "node --test test/unit/*.js",
    "test-packaged-web": "node --test test/packaged/web-smoke.js",
    "test-managed-web": "node --test test/packaged/managed-web.js",
    "test-distribution": "node --test test/packaged/npm-distribution.js",
    "stage-browser-assets": "node build/bin/browser-assets.js",
    "stage-standalone": "node build/bin/standalone.js"
  },
  "license": "MIT",
  "languageRepo": "https://github.com/Anubis-Security-Tool/anubis-packages/tree/main/locales",
  "privacyNoticeLink": "https://docs.anubis.locker/wiki/privacy-notice",
  "knownIssuesLink": "https://docs.anubis.locker/wiki/Know-issues",
  "sponsorLink": "https://anubis.locker/sponsor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anubis-Security-Tool/anubis-web.git"
  },
  "author": {
    "name": "Anubis-Security-Tool contributors (based on electerm by ZHAO Xudong)",
    "url": "https://github.com/Anubis-Security-Tool"
  },
  "bugs": {
    "url": "https://github.com/Anubis-Security-Tool/anubis-web/issues"
  },
  "homepage": "https://anubis.locker",
  "releases": "https://github.com/Anubis-Security-Tool/anubis-web/releases",
  "engines": {
    "node": ">=24.0.0"
  },
  "preferGlobal": true,
  "publishConfig": {
    "registry": "https://npm.anubis.locker/"
  },
  "devDependencies": {
    "@ai-security-tool/electerm-react": "5.7.5",
    "@ai-security-tool/icons": "1.0.1",
    "@ai-security-tool/resource": "2.2.3",
    "@ant-design/icons": "^6.2.5",
    "@fontsource/maple-mono": "^5.2.6",
    "@novnc/novnc": "^1.7.0",
    "@types/node": "22.9.3",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-attach": "0.13.0-beta.292",
    "@xterm/addon-fit": "0.12.0-beta.292",
    "@xterm/addon-image": "0.10.0-beta.292",
    "@xterm/addon-ligatures": "0.11.0-beta.292",
    "@xterm/addon-search": "0.17.0-beta.292",
    "@xterm/addon-serialize": "0.15.0-beta.292",
    "@xterm/addon-unicode11": "0.10.0-beta.292",
    "@xterm/addon-web-links": "0.13.0-beta.292",
    "@xterm/addon-webgl": "0.20.0-beta.291",
    "@xterm/xterm": "npm:@ai-security-tool/xterm@6.1.0-beta.292-electerm.2",
    "antd": "^6.5.1",
    "classnames": "2.5.1",
    "cross-env": "7.0.3",
    "escape-string-regexp": "^5.0.0",
    "express-http-proxy": "^2.1.2",
    "filesize": "10.1.6",
    "filesize-parser": "1.5.1",
    "ironrdp-wasm": "^1.1.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "1.61.0",
    "manate": "^2.0.3",
    "playwright": "1.64.1",
    "react": "^19.2.6",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.2.6",
    "react-markdown": "9.0.1",
    "remark-gfm": "^4.0.1",
    "replace-in-file": "6.3.5",
    "shelljs": "0.8.5",
    "spice-client": "^1.2.0",
    "standard": "^17.1.2",
    "stylus": "^0.64.0",
    "vite": "^8.0.15"
  },
  "dependencies": {
    "@ai-security-tool/ftp-srv": "^1.0.6",
    "@ai-security-tool/locales": "2.3.34",
    "@ai-security-tool/managed-access": "1.0.4",
    "@ai-security-tool/ssh2": "1.22.1",
    "@ai-security-tool/ssh2-scp": "3.3.0",
    "@ai-security-tool/sync": "2.1.0",
    "@ai-security-tool/themes": "1.0.2",
    "@ai-security-tool/trzsz2": "1.2.0",
    "@xterm/headless": "6.1.0-beta.292",
    "axios": "1.18.1",
    "basic-ftp": "6.0.1",
    "dayjs": "^1.11.21",
    "diffie-hellman": "^5.0.3",
    "dotenv": "16.3.1",
    "electron-log": "^4.4.8",
    "express": "5.2.1",
    "express-jwt": "^8.5.1",
    "express-ws": "5.0.2",
    "fast-deep-equal": "3.1.3",
    "find-free-port": "2.0.0",
    "font-list": "1.5.1",
    "gist-wrapper": "1.0.0",
    "gitee-client": "1.0.0",
    "glob": "^13.0.6",
    "https-proxy-agent": "7.0.1",
    "iconv-lite": "0.7.2",
    "json-deep-copy": "1.3.1",
    "jsonwebtoken": "^9.0.1",
    "lodash": "4.18.1",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "nanoid": "^5.1.11",
    "node-bash": "5.0.1",
    "node-pty": "1.2.0-beta.15",
    "os-locale-s": "^1.1.3",
    "pug": "^3.0.4",
    "serialport": "13.0.0",
    "socks": "2.8.9",
    "socks-proxy-agent": "8.0.1",
    "socksv5-server": "^1.0.2",
    "ssh-config-loader": "1.1.2",
    "tar": "^7.5.21",
    "zmodem2": "1.4.0"
  },
  "overrides": {
    "ip-address": "^10.3.1",
    "qs": "^6.16.0",
    "body-parser": "^2.3.0",
    "form-data": "^4.0.6",
    "fast-uri": "^3.1.6",
    "js-yaml": "^4.3.2",
    "@xmldom/xmldom": "^0.8.15",
    "browserslist": "^4.28.7",
    "baseline-browser-mapping": "^2.11.0",
    "postcss": "^8.5.23",
    "glob": {
      "minimatch": {
        "brace-expansion": "^5.0.7"
      }
    }
  },
  "files": [
    "npm",
    "src/app",
    "dist/assets",
    "dist/views",
    "dist/asset-manifest.json",
    "scripts/configure-managed.js",
    "scripts/start-managed.js",
    "build/bin/install.js",
    "build/bin/verify-package.js",
    ".sample.env",
    "README.md",
    "LICENSE"
  ],
  "standard": {
    "globals": [
      "log",
      "MouseEvent",
      "WebSocket",
      "FileReader",
      "CustomEvent",
      "ResizeObserver",
      "onmessage",
      "self"
    ],
    "ignore": [
      "/public/",
      "src/client/entry-web/rle.js"
    ],
    "sourceType": "module"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "node-pty@1.2.0-beta.15": true
  }
}
